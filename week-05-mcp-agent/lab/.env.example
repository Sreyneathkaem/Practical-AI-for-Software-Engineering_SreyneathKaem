# Copy this file to ".env" and fill in your values.
#
#   cp .env.example .env
#
# You do NOT need an API key to run the lab: leave OPENAI_API_KEY blank and the
# assistant runs in offline MOCK mode (a small built-in keyword router that
# imitates tool selection so you can trace the architecture).

# Your OpenAI (or OpenAI-compatible) API key. Leave blank for offline MOCK mode.
OPENAI_API_KEY=

# The chat model to use when a key is set.
OPENAI_MODEL=gpt-4o-mini

# Optional: base URL for OpenAI-compatible providers. Leave blank for OpenAI.
OPENAI_BASE_URL=

# ---- Optional overrides (defaults shown) ----
# ACADEMIC_MCP_URL=http://127.0.0.1:8001/mcp
# MATH_MCP_URL=http://127.0.0.1:8002/mcp

# Force offline MOCK mode even if an API key is set:
# OFFLINE=1
